# Salin ke .env.local lalu isi dari dashboard Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxx
CLERK_SECRET_KEY=sk_test_xxxx
# Kunci API indocast.site untuk fitur Drakor dan Movie (server-only).
# Jangan pakai awalan NEXT_PUBLIC_ agar tidak terekspos ke browser.
DRAKOR_API_KEY=indocast_xxxx
# Neon Postgres — penyimpanan riwayat baca/tonton (server-only).
# Jangan pakai awalan NEXT_PUBLIC_ agar tidak terekspos ke browser.
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require
# Produksi *.vercel.app: JANGAN isi variabel di bawah ini.
# SDK otomatis proxy via /__clerk bila key production + host .vercel.app.
# Hanya isi sebagai fallback eksplisit di env Vercel bila auto-proxy gagal:
# NEXT_PUBLIC_CLERK_PROXY_URL=https://komikobh.vercel.app/__clerk
